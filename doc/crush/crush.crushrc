#!/bin/sh
export CRUSH_DISABLE_METRICS=1
export DISABLE_METRICS=1
export DO_NOT_TRACK=1
#
source "/etc/nixos/doc/go/go.env"
if [ -e ~/.token.env ]; then source "~/.token.env" ; fi 
#
provider add ollama --type ollama --base-url "http://aiworker02.dbt.corp:11434/v1"
provider add ollamaX --type ollama --base-url "http://aiworker02.dbt.corp:44444/v1"
provider add ollamaBATCH --type ollama --base-url "http://aiworker01.dbt.corp:11434/v1"
#
permissions allow view ls grep edit write multiedit bash 
permissions allow rg jq python python3 fetch curl agentic_fetch
permissions allow lsp lsp_replace lsp_replace_symbol 
#
lsp add go --command "/run/current-system/sw/bin/gopls" --env "GOTOOLCHAIN" "go1.24.5"
lsp add typescript --command "/run/current-system/sw/bin/typescript-language-server" --args --stdio
lsp add nix --command "/run/current-system/sw/bin/nil"
#
option ui compact true
option ui completions-max-depth 4
option ui completions-max-items 200
option ui diff unified
option ui scrollbar always
option ui transparent false
#
option progress true
option attribution-trailer-style none
option attribution-generated-with false
#
if [ "$GITHUB_TOKEN" =! "" ]; then mcp add github --type http --url "https://api.githubcopilot.com/mcp/" --header Authorization "Bearer $GITHUB_TOKEN" ; fi 
